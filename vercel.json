{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "functions": {
    "api/ask.js": {
      "maxDuration": 60,
      "supportsCancellation": true
    },
    "api/water.js": {
      "maxDuration": 30
    },
    "api/accidents.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
