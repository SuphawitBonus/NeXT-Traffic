# Copy this file to .env and fill in an API key from your Anthropic Console account
# (.env is git-ignored. On Vercel, set these in Project Settings → Environment Variables
#  instead — never commit a key.)
ANTHROPIC_API_KEY=

# Optional: port for the local dev API server (Vite proxies /api to it)
# API_PORT=8787

# Optional: output-token ceiling for one /api/ask answer (default 2000, max 16000).
# This is the main cost knob for a public demo.
# ASK_MAX_TOKENS=2000
